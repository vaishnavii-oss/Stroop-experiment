  </Routines>
  <Flow>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('s_image', 'dog.jpg'), ('r_image', 'horse.jpg'), ('target_sound', 'dog.wav.mp3'), ('correct', 'dog.jpg')]), OrderedDict([('s_image', 'penguin.jpg'), ('r_image', 'tiger.jpg'), ('target_sound', 'tiger.wav.mp3'), ('correct', 'tiger.jpg')]), OrderedDict([('s_image', 'horse.jpg'), ('r_image', 'dog.jpg'), ('target_sound', 'horse.wav.mp3'), ('correct', 'horse.jpg')]), OrderedDict([('s_image', 'tiger.jpg'), ('r_image', 'penguin.jpg'), ('target_sound', 'penguin.wav.mp3'), ('correct', 'penguin.jpg')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="trials.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="20" valType="num"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="start"/>
    <Routine name="trial"/>
    <LoopTerminator name="trials"/>
  </Flow>
</PsychoPy2experiment>
